# Toolchain this project actually builds with. direnv loads it on cd —
# run `direnv allow` once after cloning.
#
# Both variables below have cost a full build cycle each, because neither
# failure names itself. See docs/deployment/android-build.md.

# JDK 17. React Native 0.81's CMake configure step fails on JDK 24, and the
# only thing Gradle prints is "WARNING: A restricted method in
# java.lang.System has been called" — which reads like a warning rather than
# the reason five :configureCMakeRelWithDebInfo tasks just died.
for candidate in \
  /opt/homebrew/opt/openjdk@17 \
  /usr/local/opt/openjdk@17 \
  "$(/usr/libexec/java_home -v 17 2>/dev/null)"
do
  if [ -x "$candidate/bin/java" ]; then
    export JAVA_HOME="$candidate"
    PATH_add "$candidate/bin"
    break
  fi
done

if [ -z "${JAVA_HOME:-}" ]; then
  log_error "No JDK 17 found. brew install openjdk@17 — Android builds fail on 21+."
fi

# Android SDK. A non-login shell (a backgrounded build, CI, an editor task)
# does not inherit this, and Gradle then reports only "SDK location not found".
for sdk in "$HOME/Library/Android/sdk" "$HOME/Android/Sdk" "${ANDROID_HOME:-}"; do
  if [ -d "$sdk/platform-tools" ]; then
    export ANDROID_HOME="$sdk"
    export ANDROID_SDK_ROOT="$sdk"
    PATH_add "$sdk/platform-tools"
    PATH_add "$sdk/emulator"
    break
  fi
done

if [ -z "${ANDROID_HOME:-}" ]; then
  log_error "No Android SDK found. Install it via Android Studio, or set ANDROID_HOME."
fi

dotenv_if_exists .env
